generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum SportType {
  PADEL
  TENNIS
  SQUASH
  PICKLEBALL
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique @db.VarChar(255)
  name         String    @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at")
  bookings     Booking[]

  @@map("users")
}

model Court {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(100)
  sportType        SportType @map("sport_type")
  hourlyPriceCents Int       @map("hourly_price_cents")
  openHour         Int       @map("open_hour")
  closeHour        Int       @map("close_hour")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  bookings         Booking[]

  @@map("courts")
}

model Booking {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  courtId         Int           @map("court_id")
  startsAt        DateTime      @map("starts_at")
  endsAt          DateTime      @map("ends_at")
  durationHours   Int           @map("duration_hours")
  status          BookingStatus @default(CONFIRMED)
  totalPriceCents Int           @map("total_price_cents")
  createdAt       DateTime      @default(now()) @map("created_at")
  cancelledAt     DateTime?     @map("cancelled_at")
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  court           Court         @relation(fields: [courtId], references: [id], onDelete: Restrict)
  slots           BookingSlot[]

  @@unique([id, courtId])
  @@index([userId, startsAt])
  @@index([courtId, startsAt])
  @@index([startsAt])
  @@map("bookings")
}

model BookingSlot {
  courtId   Int      @map("court_id")
  slotStart DateTime @map("slot_start")
  bookingId Int      @map("booking_id")
  booking   Booking  @relation(fields: [bookingId, courtId], references: [id, courtId], onDelete: Cascade)

  @@id([courtId, slotStart])
  @@index([bookingId, courtId])
  @@map("booking_slots")
}
